/* =========================================================
CAELIX ARCADE
GLOBAL STYLES
========================================================= */

/* =========================================================
GRUNDLAGEN
========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  }

html {
min-height: 100%;
scroll-behavior: smooth;
}

body {
min-height: 100vh;
font-family: "Courier New", monospace;
background:
radial-gradient(
circle at 50% 20%,
#3b125f 0%,
#170b2d 35%,
#07040e 75%,
#020207 100%
);
color: #ffffff;
overflow-x: hidden;
}

button {
font-family: inherit;
}

.hidden {
display: none !important;
}

/* =========================================================
SCANLINES
========================================================= */

.scanlines {
position: fixed;
inset: 0;
pointer-events: none;
z-index: 1000;

background:
    repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,0.025) 0px,
        rgba(255,255,255,0.025) 1px,
        transparent 1px,
        transparent 4px
    );

}

/* =========================================================
ARCADE STARTSEITE
========================================================= */

.arcade-home {
min-height: 100vh;
padding: 30px 20px 50px;
position: relative;
overflow: hidden;
}

/* =========================================================
DEKORATIVE STERNE
========================================================= */

.arcade-stars {
position: absolute;
inset: 0;
pointer-events: none;
overflow: hidden;
}

.arcade-stars span {
position: absolute;
font-size: 20px;
opacity: 0.55;
animation: twinkle 2.5s infinite alternate;
}

.arcade-stars span:nth-child(1) {
left: 8%;
top: 15%;
}

.arcade-stars span:nth-child(2) {
left: 20%;
top: 40%;
animation-delay: .5s;
}

.arcade-stars span:nth-child(3) {
left: 82%;
top: 20%;
animation-delay: 1s;
}

.arcade-stars span:nth-child(4) {
left: 90%;
top: 65%;
animation-delay: .8s;
}

.arcade-stars span:nth-child(5) {
left: 12%;
top: 80%;
animation-delay: 1.4s;
}

.arcade-stars span:nth-child(6) {
left: 70%;
top: 85%;
animation-delay: 1.8s;
}

@keyframes twinkle {

from {
    opacity: 0.25;
    transform: scale(.8);
}

to {
    opacity: 1;
    transform: scale(1.3);
}

}

/* =========================================================
HEADER
========================================================= */

.arcade-header {
position: relative;
z-index: 2;

display: flex;
align-items: center;
justify-content: center;
gap: 25px;

flex-wrap: wrap;

text-align: center;

margin-bottom: 25px;

}

.arcade-header h1 {
width: 100%;

font-size: clamp(
    40px,
    8vw,
    90px
);

line-height: 1;

text-transform: uppercase;

color: #ffffff;

text-shadow:
    4px 4px 0 #ff00aa,
    8px 8px 0 #00eaff,
    0 0 20px #ff00aa,
    0 0 40px #00eaff;

letter-spacing: 4px;

animation: arcadeLogo 2s ease-in-out infinite alternate;

}

@keyframes arcadeLogo {

from {
    transform: scale(1);
}

to {
    transform: scale(1.015);
}

}

.logo-decoration {
font-size: 45px;
color: #ffe600;

text-shadow:
    0 0 8px #ffe600,
    0 0 20px #ff8c00;

}

.arcade-subtitle {
width: 100%;

font-size: 14px;

color: #00eaff;

letter-spacing: 5px;

text-shadow:
    0 0 8px #00eaff;

}

/* =========================================================
PLAYER BAR
========================================================= */

.player-bar {
position: relative;
z-index: 2;

width: min(
    1200px,
    100%
);

margin: 0 auto 45px;

padding: 14px 18px;

display: flex;
align-items: center;
justify-content: space-between;
gap: 15px;

flex-wrap: wrap;

background:
    linear-gradient(
        90deg,
        #120c25,
        #26113e,
        #120c25
    );

border: 3px solid #00eaff;

box-shadow:
    0 0 10px #00eaff,
    inset 0 0 20px rgba(0,234,255,.15);

}

.player-info {
display: flex;
align-items: center;
gap: 10px;

font-weight: bold;

}

.status-light {
width: 12px;
height: 12px;

display: inline-block;

border-radius: 50%;

background: #00ff66;

box-shadow:
    0 0 10px #00ff66;

}

.currency {
display: flex;
align-items: center;
gap: 8px;

color: #ffe600;

font-weight: bold;

text-shadow:
    0 0 8px #ffe600;

}

.staron-symbol {
font-size: 24px;
}

/* =========================================================
BUTTONS
========================================================= */

.arcade-button,
.pixel-button,
.machine-play {

border: 3px solid #ffffff;

background: #221039;

color: #ffffff;

padding: 10px 18px;

cursor: pointer;

font-weight: bold;

letter-spacing: 1px;

box-shadow:
    4px 4px 0 #000000,
    0 0 8px rgba(255,255,255,.4);

transition:
    transform .12s,
    box-shadow .12s,
    background .12s;

}

.arcade-button:hover,
.pixel-button:hover,
.machine-play:hover {

transform: translate(
    2px,
    2px
);

box-shadow:
    2px 2px 0 #000000,
    0 0 15px #ffffff;

}

.arcade-button:active,
.pixel-button:active,
.machine-play:active {

transform: translate(
    4px,
    4px
);

box-shadow:
    none;

}

.discord-button {
border-color: #7289da;

box-shadow:
    4px 4px 0 #000000,
    0 0 10px #7289da;

}

/* =========================================================
SECTION TITEL
========================================================= */

.arcade-floor {
position: relative;
z-index: 2;

width: min(
    1400px,
    100%
);

margin: auto;

}

.section-title {
display: flex;

align-items: center;
justify-content: center;

gap: 15px;

margin-bottom: 35px;

color: #ffe600;

text-shadow:
    0 0 10px #ffe600;

}

.section-title h2 {
font-size: clamp(
18px,
3vw,
30px
);

letter-spacing: 3px;

}

/* =========================================================
SPIELAUTOMATEN
========================================================= */

.machines-container {

display: grid;

grid-template-columns:
    repeat(
        auto-fit,
        minmax(
            280px,
            1fr
        )
    );

gap: 35px;

align-items: end;

}

.arcade-machine {

position: relative;

min-height: 500px;

padding: 15px;

background:
    linear-gradient(
        135deg,
        #39145e,
        #160b29 50%,
        #291047
    );

border: 5px solid #ff00aa;

border-radius: 18px 18px 8px 8px;

box-shadow:
    0 0 10px #ff00aa,
    0 0 30px rgba(255,0,170,.35),
    inset 0 0 25px rgba(0,0,0,.7);

transition:
    transform .25s,
    filter .25s;

}

.arcade-machine.playable:hover {

transform:
    translateY(-10px)
    scale(1.02);

box-shadow:
    0 0 15px #ff00aa,
    0 0 45px rgba(255,0,170,.6),
    inset 0 0 25px rgba(0,0,0,.7);

}

.arcade-machine.playable {

cursor: pointer;

}

/* =========================================================
MACHINE MARQUEE
========================================================= */

.machine-marquee {

min-height: 70px;

display: flex;

align-items: center;
justify-content: space-between;

gap: 8px;

padding: 8px;

background:
    linear-gradient(
        180deg,
        #ff2abf,
        #8e006f
    );

border: 3px solid #ffe600;

box-shadow:
    inset 0 0 10px #000000,
    0 0 8px #ffe600;

}

.machine-marquee h3 {

font-size: 24px;

color: #ffffff;

text-align: center;

text-shadow:
    2px 2px 0 #000000,
    0 0 10px #ffffff;

}

.marquee-lights {

color: #ffe600;

font-size: 11px;

white-space: nowrap;

}

/* =========================================================
MACHINE SCREEN
========================================================= */

.machine-screen {

margin-top: 18px;

min-height: 190px;

padding: 15px;

background:
    #02030a;

border: 8px solid #111111;

border-radius: 12px;

box-shadow:
    inset 0 0 20px #00eaff,
    0 0 10px #00eaff;

display: flex;

align-items: center;
justify-content: center;

}

.screen-glow {

width: 100%;

min-height: 150px;

display: flex;

flex-direction: column;

align-items: center;
justify-content: center;

gap: 10px;

background:
    radial-gradient(
        circle,
        rgba(0,234,255,.18),
        transparent 65%
    );

}

.screen-glow strong {

color: #00eaff;

font-size: 24px;

letter-spacing: 2px;

text-shadow:
    0 0 8px #00eaff;

}

.screen-glow small {

color: #ffffff;

font-size: 11px;

letter-spacing: 2px;

}

.fruit-preview {

display: flex;

gap: 7px;

font-size: 34px;

animation:
    fruitFloat 1.8s ease-in-out infinite alternate;

}

@keyframes fruitFloat {

from {
    transform: translateY(4px);
}

to {
    transform: translateY(-5px);
}

}

.question-mark {

font-size: 70px;

color: #ff00aa;

text-shadow:
    0 0 15px #ff00aa;

}

/* =========================================================
MACHINE CONTROLS
========================================================= */

.machine-controls {

display: flex;

align-items: center;

justify-content: space-around;

padding: 20px 5px;

}

.joystick {

position: relative;

width: 70px;

height: 75px;

}

.joystick-stick {

position: absolute;

width: 15px;
height: 45px;

left: 28px;
top: 18px;

background:
    linear-gradient(
        90deg,
        #333,
        #999,
        #222
    );

transform:
    rotate(
        -8deg
    );

}

.joystick-ball {

position: absolute;

width: 35px;
height: 35px;

left: 18px;
top: 0;

border-radius: 50%;

background:
    radial-gradient(
        circle at 30% 30%,
        #ff5555,
        #990000
    );

border: 3px solid #222;

box-shadow:
    0 0 10px #ff0000;

}

.machine-buttons {

display: flex;

gap: 10px;

align-items: center;

}

.round-button {

width: 27px;
height: 27px;

border-radius: 50%;

display: block;

border: 3px solid #222;

background: #555;

box-shadow:
    inset 2px 2px 4px rgba(255,255,255,.3),
    0 3px 0 #000;

}

.round-button.red {
background: #ff2020;
}

.round-button.yellow {
background: #ffe600;
}

.round-button.blue {
background: #00eaff;
}

/* =========================================================
MACHINE BOTTOM
========================================================= */

.machine-bottom {

display: flex;

align-items: center;

justify-content: space-between;

gap: 15px;

margin-top: auto;

padding: 12px;

background: #0b0616;

border-top: 3px solid #ff00aa;

}

.coin-slot {

width: 45px;
height: 45px;

display: flex;

align-items: center;
justify-content: center;

border: 3px solid #ffe600;

color: #ffe600;

font-size: 20px;

box-shadow:
    0 0 8px #ffe600;

}

.machine-play {

border-color: #00ff66;

color: #00ff66;

background: #061a12;

box-shadow:
    4px 4px 0 #000,
    0 0 10px #00ff66;

}

.machine-play.disabled {

opacity: .4;

cursor: not-allowed;

}

/* =========================================================
COMING SOON
========================================================= */

.coming-soon {

filter: grayscale(.65);

opacity: .75;

}

.coming-soon:hover {

transform: none;

}

/* =========================================================
FOOTER
========================================================= */

.arcade-footer {

position: relative;

z-index: 2;

margin-top: 60px;

text-align: center;

color: #8b78a6;

font-size: 11px;

line-height: 2;

letter-spacing: 2px;

}

/* =========================================================
GAME SCREEN
========================================================= */

.game-screen {

min-height: 100vh;

padding: 15px;

background:
    radial-gradient(
        circle at center,
        #291044,
        #08040e 70%
    );

}

.game-header {

min-height: 70px;

display: flex;

align-items: center;
justify-content: space-between;

gap: 15px;

margin-bottom: 15px;

padding: 10px 15px;

border: 3px solid #00eaff;

background: #10091d;

box-shadow:
    0 0 12px #00eaff;

}

.game-title {

display: flex;

align-items: center;

gap: 12px;

}

.game-title h1 {

color: #ffe600;

font-size: clamp(
    22px,
    4vw,
    40px
);

text-shadow:
    0 0 10px #ffe600;

}

.game-title span {

color: #ff00aa;

font-size: 22px;

}

.game-currency {

color: #ffe600;

font-weight: bold;

}

/* =========================================================
GAME LAYOUT
========================================================= */

.game-layout {

width: min(
    1500px,
    100%
);

margin: auto;

display: grid;

grid-template-columns:
    180px
    minmax(
        400px,
        1fr
    )
    230px;

gap: 20px;

}

/* =========================================================
GAME SIDEBAR
========================================================= */

.game-sidebar,
.opponent-sidebar {

padding: 12px;

background: #0e0819;

border: 3px solid #ff00aa;

box-shadow:
    0 0 12px rgba(255,0,170,.5);

}

.stat-box {

margin-bottom: 10px;

padding: 10px;

text-align: center;

border: 2px solid #6f4c8c;

background: #160d24;

}

.stat-box span {

display: block;

font-size: 10px;

color: #a996b8;

margin-bottom: 5px;

}

.stat-box strong {

display: block;

color: #00eaff;

font-size: 22px;

text-shadow:
    0 0 8px #00eaff;

}

.shape-box strong {

font-size: 14px;

color: #ffe600;

}

.reset-button,
.shop-button {

width: 100%;

margin-top: 8px;

}

.shop-button {

border-color: #ffe600;

color: #ffe600;

}

/* =========================================================
BOARD AREA
========================================================= */

.game-board-area {

display: flex;

flex-direction: column;

align-items: center;

justify-content: center;

min-width: 0;

}

.board-title {

margin-bottom: 12px;

color: #ffe600;

font-weight: bold;

letter-spacing: 2px;

text-align: center;

}

.board-title span {

color: #ff00aa;

}

.game-board {

width: min(
    650px,
    80vw
);

height: min(
    650px,
    80vw
);

display: grid;

grid-template-columns:
    repeat(
        10,
        1fr
    );

gap: 4px;

padding: 10px;

background: #090510;

border: 4px solid #00eaff;

box-shadow:
    0 0 20px #00eaff,
    inset 0 0 20px rgba(0,234,255,.2);

}

.round-reward {

margin-top: 12px;

color: #ffe600;

}

.round-reward strong {

color: #00ff66;

}

/* =========================================================
BOARD CELLS
========================================================= */

.fruit-cell {

position: relative;

min-width: 0;
min-height: 0;

display: flex;

align-items: center;
justify-content: center;

cursor: pointer;

border: 2px solid rgba(255,255,255,.1);

background:
    rgba(255,255,255,.03);

transition:
    transform .12s,
    background .12s,
    filter .12s;

}

.fruit-cell:hover {

transform: scale(1.07);

background:
    rgba(0,234,255,.15);

z-index: 3;

}

.fruit-cell.selected {

transform: scale(1.08);

border-color: #ffe600;

box-shadow:
    0 0 12px #ffe600;

z-index: 4;

}

.fruit-cell.stone {

cursor: not-allowed;

filter:
    grayscale(1)
    brightness(.65);

}

.fruit-cell.stone::after {

content: "🪨";

position: absolute;

inset: 0;

display: flex;

align-items: center;
justify-content: center;

font-size: 70%;

background:
    rgba(40,40,40,.55);

}

.fruit-image {

width: 82%;

height: 82%;

object-fit: contain;

image-rendering: auto;

user-select: none;

pointer-events: none;

}

/* =========================================================
FRUIT ANIMATIONEN
========================================================= */

.fruit-cell.matching {

animation:
    fruitMatch .35s
    ease-in-out
    forwards;

}

@keyframes fruitMatch {

0% {
    transform: scale(1);
    opacity: 1;
}

50% {
    transform: scale(1.3) rotate(8deg);
    opacity: 1;
}

100% {
    transform: scale(0);
    opacity: 0;
}

}

.fruit-cell.new-fruit {

animation:
    fruitDrop .35s
    ease-out;

}

@keyframes fruitDrop {

from {

    transform:
        translateY(
            -40px
        )
        scale(.5);

    opacity: 0;

}

to {

    transform:
        translateY(0)
        scale(1);

    opacity: 1;

}

}

/* =========================================================
VOIDVORKA
========================================================= */

.opponent-title {

text-align: center;

font-size: 18px;

color: #ff00aa;

margin-bottom: 10px;

text-shadow:
    0 0 10px #ff00aa;

}

.voidvorka-frame {

min-height: 190px;

display: flex;

align-items: center;
justify-content: center;

padding: 10px;

border: 3px solid #6f4c8c;

background:
    radial-gradient(
        circle,
        #241033,
        #08040e
    );

}

.voidvorka-frame img {

width: 100%;

max-height: 180px;

object-fit: contain;

filter:
    drop-shadow(
        0 0 10px
        rgba(255,0,170,.5)
    );

}

.opponent-text {

margin-top: 10px;

min-height: 50px;

font-size: 11px;

line-height: 1.5;

text-align: center;

color: #ffffff;

}

.stone-info {

margin-top: 8px;

padding: 8px;

text-align: center;

font-size: 10px;

color: #aaa;

border: 2px solid #44384e;

}

/* =========================================================
INVENTAR
========================================================= */

.inventory-title {

margin-top: 20px;

margin-bottom: 8px;

color: #ffe600;

text-align: center;

font-size: 13px;

}

.inventory {

display: grid;

grid-template-columns:
    repeat(
        2,
        1fr
    );

gap: 6px;

}

.inventory-item {

position: relative;

padding: 5px;

min-height: 65px;

border: 2px solid #5d4a69;

background: #170d23;

cursor: pointer;

text-align: center;

}

.inventory-item:hover {

border-color: #00eaff;

box-shadow:
    0 0 8px #00eaff;

}

.inventory-item img {

width: 40px;

height: 40px;

object-fit: contain;

}

.inventory-count {

position: absolute;

right: 2px;
bottom: 2px;

min-width: 18px;

padding: 2px;

background: #000;

color: #ffe600;

font-size: 10px;

}

.opponent-tip {

margin-top: 15px;

padding: 8px;

border: 2px dashed #6f4c8c;

font-size: 10px;

line-height: 1.4;

}

.opponent-tip strong {

color: #00eaff;

}

/* =========================================================
GAME FOOTER
========================================================= */

.game-footer {

width: min(
    1500px,
    100%
);

margin: 15px auto 0;

display: flex;

justify-content: space-between;

gap: 10px;

font-size: 9px;

color: #75647f;

}

/* =========================================================
MODAL
========================================================= */

.modal {

position: fixed;

inset: 0;

z-index: 2000;

display: flex;

align-items: center;
justify-content: center;

padding: 20px;

background:
    rgba(
        0,
        0,
        0,
        .8
    );

backdrop-filter:
    blur(4px);

}

.modal-window {

position: relative;

width: min(
    600px,
    100%
);

max-height: 90vh;

overflow-y: auto;

padding: 25px;

background:
    linear-gradient(
        135deg,
        #28103d,
        #0d0716
    );

border: 4px solid #ffe600;

box-shadow:
    0 0 20px #ffe600,
    0 0 50px rgba(255,230,0,.3);

}

.modal-close {

position: absolute;

top: 8px;
right: 10px;

width: 35px;
height: 35px;

border: 2px solid #ff00aa;

background: #17091f;

color: #ffffff;

font-size: 24px;

cursor: pointer;

}

.modal-content {

padding-top: 10px;

}

.modal-content h2 {

color: #ffe600;

margin-bottom: 15px;

text-shadow:
    0 0 8px #ffe600;

}

.modal-content p {

color: #ddd;

line-height: 1.6;

margin-bottom: 12px;

}

/* =========================================================
RESPONSIVE DESIGN
========================================================= */

@media (
max-width: 1100px
) {

.game-layout {

    grid-template-columns:
        150px
        minmax(
            350px,
            1fr
        )
        200px;

    gap: 12px;

}

}

@media (
max-width: 850px
) {

.game-layout {

    grid-template-columns: 1fr;

}


.game-sidebar {

    display: grid;

    grid-template-columns:
        repeat(
            3,
            1fr
        );

    gap: 8px;

}


.stat-box {

    margin: 0;

}


.reset-button,
.shop-button {

    margin: 0;

}


.opponent-sidebar {

    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 10px;

    align-items: center;

}


.opponent-title {

    grid-column:
        1 / -1;

}


.inventory-title {

    margin: 0;

}


.opponent-tip {

    display: none;

}

}

@media (
max-width: 600px
) {

.arcade-home {

    padding:
        20px 10px 30px;

}


.arcade-header h1 {

    letter-spacing: 1px;

}


.logo-decoration {

    display: none;

}


.arcade-subtitle {

    letter-spacing: 2px;

}


.player-bar {

    justify-content: center;

}


.game-header {

    flex-wrap: wrap;

    justify-content: center;

}


.game-board {

    width: 95vw;

    height: 95vw;

    gap: 2px;

    padding: 5px;

}


.game-sidebar {

    grid-template-columns:
        repeat(
            2,
            1fr
        );

}


.opponent-sidebar {

    grid-template-columns: 1fr;

}


.game-footer {

    flex-direction: column;

    text-align: center;

}

}

/* =========================================================
ACCESSIBILITY
========================================================= */

button:focus-visible {

outline: 3px solid #ffe600;

outline-offset: 3px;

}

/* =========================================================
ENDE
========================================================= */
